[Unit]
Description=Readwise 后台任务（生成书页、合成播客）
After=network.target

[Service]
Type=simple
User=readwise
Group=readwise
WorkingDirectory=/srv/readwise/app
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=READWISE_DATA_DIR=/srv/readwise/data
ExecStart=/usr/bin/env node --env-file-if-exists=.env worker/worker.mjs
Restart=always
RestartSec=5
# 收到退出信号后会等当前任务做完（播客最长约 15 分钟），避免半途丢任务
KillSignal=SIGTERM
TimeoutStopSec=1200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

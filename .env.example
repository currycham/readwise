# 复制为 .env 后填写。只填你开通了的几项即可。

# DeepSeek 官方
DEEPSEEK_API_KEY=
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# DEEPSEEK_FLASH_MODEL=deepseek-flash

# 腾讯混元旧版接口（已迁移到 TokenHub，新 key 请填下面的 TOKENHUB_*）
HUNYUAN_API_KEY=
# HY4_MODEL=hy4-preview
# HY3_MODEL=hy3

# 腾讯云 TokenHub 按量计费：可调用混元、DeepSeek、Kimi、GLM、MiniMax 语音
# TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
# TOKENHUB_API_KEY=
# DEEPSEEK_PRO_PROVIDER=tokenhub
# HY4_PROVIDER=tokenhub
# HY3_PROVIDER=tokenhub

# 阿里云百炼（通义千问）
DASHSCOPE_API_KEY=
# QWEN_MAX_MODEL=qwen3.7-max

# 联网搜索：博查 Web Search API；没有 key 时可设 SEARCH_PROVIDER=none（只用模型自身知识，仅供测试）
BOCHA_API_KEY=
# SEARCH_PROVIDER=none

# 各环节使用的模型（alias 见 config/models.mjs）
# ROLE_GENERATE=deepseek-pro
# ROLE_CHECK=hy3
# ROLE_ASK=hy3

# 资料充分度门槛（0–9）
# EVIDENCE_THRESHOLD=6

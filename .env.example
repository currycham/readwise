# 复制为 .env 后填写。只填你开通了的几项即可。

# DeepSeek 官方
DEEPSEEK_API_KEY=
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# DEEPSEEK_FLASH_MODEL=deepseek-flash

# 腾讯混元旧版接口（已迁移到 TokenHub，新 key 请填下面的 TOKENHUB_*）
HUNYUAN_API_KEY=
# HY4_MODEL=hy4-preview
# HY3_MODEL=hy3

# 腾讯云 TokenHub 按量计费：可调用混元、DeepSeek、Kimi、GLM、MiniMax 语音
# TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
# TOKENHUB_API_KEY=
# DEEPSEEK_PRO_PROVIDER=tokenhub
# HY4_PROVIDER=tokenhub
# HY3_PROVIDER=tokenhub

# 阿里云百炼（通义千问）
DASHSCOPE_API_KEY=
# QWEN_MAX_MODEL=qwen3.7-max

# 联网搜索：博查 Web Search API；没有 key 时可设 SEARCH_PROVIDER=none（只用模型自身知识，仅供测试）
BOCHA_API_KEY=
# SEARCH_PROVIDER=none

# 各环节使用的模型（alias 见 config/models.mjs）
# ROLE_GENERATE=deepseek-pro
# ROLE_CHECK=hy3
# ROLE_ASK=hy3

# 资料充分度门槛（0–9）
# EVIDENCE_THRESHOLD=6

# ---------- 播客语音合成（腾讯云 TokenHub 上的 MiniMax，复用 TOKENHUB_API_KEY） ----------
# TTS_MODEL=minimax-speech-2.8-turbo
# TTS_VOICE_A="Chinese (Mandarin)_Gentle_Youth"   # 领读人
# TTS_VOICE_B="Chinese (Mandarin)_Warm_Bestie"    # 提问者
# TTS_SPEED=1.0
# TTS_PRICE_PER_10K=2               # 元 / 万计费字符，按控制台核实
# TTS_CONCURRENCY=3              # 整个 worker 同时发出的配音请求数，TokenHub 并发上限约 5

# ---------- 网站 ----------
# 登录会话签名密钥，生产环境必须改成随机长字符串（openssl rand -hex 32）
SESSION_SECRET=
# 管理员邮箱 / 手机号，逗号分隔；用这些账号登录后自动成为管理员（可进 /admin）
ADMIN_EMAILS=
# ADMIN_PHONES=
# 开放的登录方式：email、phone，逗号分隔。默认只开邮箱（手机号需要企业资质的短信签名）
# LOGIN_METHODS=email
# 同一 IP 每 24 小时最多注册几个新账号（防批量注册薅免费额度），0 = 不限
# SIGNUP_PER_IP_DAY=3
# 数据目录（SQLite、书页、播客音频），默认 ./out
# READWISE_DATA_DIR=/data/readwise
# 没有 HTTPS 时（内网调试）允许非 secure cookie
# INSECURE_COOKIE=1
# 页脚显示的备案号
# NEXT_PUBLIC_ICP=京ICP备XXXXXXXX号
# 后台任务进程同时处理的任务数
# WORKER_CONCURRENCY=2

# 腾讯云 API 密钥（短信、内容安全共用）
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=

# 邮件验证码：dev = 不发邮件，验证码打印在网站日志里；smtp = 通过 SMTP 发送
# 腾讯云服务器封了 25 端口，用 465（SSL）或 587。QQ 邮箱：smtp.qq.com，密码填“授权码”
# MAIL_PROVIDER=dev
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Readwise <xxx@qq.com>"   # 发件人，地址必须和 SMTP_USER 一致（QQ 邮箱要求）
# SITE_NAME=Readwise

# 短信验证码：dev = 不发短信，验证码打印在网站日志里；tencent = 腾讯云短信
# SMS_PROVIDER=dev
# SMS_SDK_APP_ID=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_ID=
# SMS_TEMPLATE_PARAMS=2            # 模板变量个数：{1} 验证码、{2} 有效分钟数；模板只有 {1} 时填 1
# SMS_REGION=ap-guangzhou

# 内容安全审核：none = 跳过（仅开发）；tencent = 腾讯云文本内容安全，正式上线前必须开启
# MODERATION_PROVIDER=none
# TMS_BIZ_TYPE=
# TMS_REGION=ap-guangzhou

# ---------- 套餐与额度（默认值见 config/plans.mjs） ----------
# FREE_GEN_PER_MONTH=1
# FREE_ASKS_PER_DAY=10
# MEMBER_PRICE=15
# MEMBER_PRICE_YEAR=128
# MEMBER_GEN_PER_MONTH=5
# MEMBER_ASKS_PER_DAY=100
# PRICE_EXTRA_GEN=30                # 积分 / 本，超出月度额度后（10 积分 = 1 元）
# PRICE_EXTRA_ASK=1                 # 积分 / 问，超出每日额度后
# SIGNUP_BONUS=20
# DAILY_BUDGET_YUAN=200             # 全站每日模型成本上限

# 播客目标时长（分钟），默认 18，成稿约 15–20 分钟
# PODCAST_MINUTES=18

# 读书赚积分（默认值见 config/plans.mjs 的 REWARDS）
# REWARD_COMPLETE=5
# REWARD_PERFECT=3
# REWARD_COMPLETE_CAP=60
# REWARD_MIN_MINUTES=10
# REWARD_GENERATE=5
# REWARD_GENERATE_CAP=25
# REWARD_CONTRIB=2
# REWARD_CONTRIB_BOOK_CAP=40
# REWARD_CONTRIB_CAP=100
